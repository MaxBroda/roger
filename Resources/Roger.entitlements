<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Bewusst ohne App Sandbox: Ein CGEventTap und systemweiter Zugriff über
	     die Bedienungshilfen sind darin beide unmöglich. Verteilt würde Roger
	     per Developer ID, nicht über den Mac App Store. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
